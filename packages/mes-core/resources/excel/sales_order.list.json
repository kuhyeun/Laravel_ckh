        { "field": "order_name",   "header": "수주명",   "width": 20 },
        { "field": "item_code",    "header": "품번",     "width": 16 },
        { "field": "item_name",    "header": "품명",     "width": 24 },
        { "field": "qty",          "header": "수량",     "width": 10, "numFmt": "#,##0.######" },
        { "field": "spec_unit",    "header": "단위",     "width": 7 },
        { "field": "unit_price",   "header": "단가",     "width": 12, "numFmt": "#,##0" },
